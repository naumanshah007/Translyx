# Translyx environment variables
# Copy relevant values into .env.local (local dev) and into Vercel project settings (production).

# --- Contact form (Resend) ---
RESEND_API_KEY=
# While using Resend's onboarding sender, this must be the verified account
# inbox. After verifying a Translyx sending domain, both values can be updated.
CONTACT_FORM_RECIPIENT=info@privexa.co
CONTACT_FORM_SENDER="Translyx Website <onboarding@resend.dev>"

# --- News intelligence backend (ships DISABLED) ---
# The daily news refresh stays off until ALL of the following are set in Vercel:
#   1. GEMINI_API_KEY is provided
#   2. NEWS_REFRESH_ENABLED is set to the literal string "true"
# Until then, /news renders from config/news.seed.json and the cron endpoint
# returns 200 {skipped:"disabled"}.

# Google Generative Language API key (server-side only — never expose to the client)
GEMINI_API_KEY=

# Shared secret protecting /api/cron/refresh-news.
# IMPORTANT: Vercel Cron auto-attaches the bearer token only from an env var named
# exactly CRON_SECRET. Set BOTH NEWS_REFRESH_SECRET and CRON_SECRET to the SAME value
# so scheduled runs authenticate and manual curl calls work too.
NEWS_REFRESH_SECRET=
CRON_SECRET=

# Master on/off switch for the live refresh. Must be the literal string "true" to enable.
NEWS_REFRESH_ENABLED=false

# Vercel Blob storage token — auto-provisioned by Vercel when a Blob store is
# attached to the project. Needed for the news refresh to persist results.
BLOB_READ_WRITE_TOKEN=
